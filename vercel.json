{
  "rewrites": [
    {
      "source": "/dp/:name",
      "destination": "/api/index.py?name=:name"
    },
    {
      "source": "/",
      "destination": "/KM_unsigned.mobileconfig"
    }
  ],
  "headers": [
    {
      "source": "/KM_unsigned.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=KM_unsigned.mobileconfig"
        }
      ]
    }
  ]
}